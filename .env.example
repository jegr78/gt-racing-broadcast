# GT Racing Broadcast -- machine-local config. Copy to ".env" (gitignored) and fill in.
#   cp .env.example .env
# Real environment variables take precedence over values in this file.
#
# League config (Google Sheet ID + push URL + intro/outro) is NOT here -- it
# lives per league in profiles/<name>/profile.env (see `racecast profile new`).

# OPTIONAL: OBS WebSocket password for the feed-port release on `racecast ... stop`
# (OBS is asked to stop the relay-fed media inputs so the feed ports tear down
# cleanly). Normally NOT needed -- the password is auto-read from OBS's own
# obs-websocket config on this machine. Set it only for portable/non-standard
# OBS installs where that config is not in the default location.
RACECAST_OBS_WS_PASSWORD=

# RACECAST_OBS_WS_PERSIST=0   # #537: disable persistent obs-websocket reuse (connect-per-call)

# Relay feed fan-out (DEFAULT ON, live-verified). The relay is the single streamlink
# consumer and re-serves each feed to OBS + the preview, fixing the ~2s
# stale-on-activation glitch and freeing the preview tap. Set this to 0 to fall back to
# the proven direct-serve path. See docs/superpowers/specs/2026-06-28-relay-feed-fanout-design.md
# EMERGENCY FALLBACK: if the on-air feed ever freezes/stutters after a mid-broadcast
# stream restart and won't recover, set =0 (direct-serve, where a streamlink restart makes
# OBS reconnect on its own). The relay normally forces that reconnect for you in fan-out
# mode; the "RESET <feed> -> OBS" panel button does it on demand.
# RACECAST_FEED_FANOUT=0
# RACECAST_FEED_STALL_S=20               # byte-stall grace (s) before a fan-out re-resolve
# RACECAST_FEED_PREBUFFER_S=3.0          # #533: seconds OBS/program-audio join behind the fan-out
#                                        # live edge so bursty source gaps don't stutter (0 = live edge)
# RACECAST_FEED_STALL_SIGNAL=0           # #535: disable the inbound-stall yellow (gap still sampled to the DB)
# RACECAST_FEED_STALL_FLOOR_S=1.0        # #535: min inbound gap (s) that can count as a stall

# OBS scene-collection auto-switch (DEFAULT ON). On `event start`, switch OBS to the
# active profile's scene collection when a different one is loaded, so a prior league's
# collection can't linger on a shared multi-league box. Safe: OBS refuses a switch while
# an output is active. Set to 0 for the old warn-only behaviour.
# RACECAST_OBS_COLLECTION_SWITCH=0

# OBS Standby scene on `event start` (DEFAULT ON). After bring-up, park OBS on the
# Standby scene so the producer is ready to Start Streaming (Director Guide: start on
# Standby). Best-effort; never cuts a live program (skipped when OBS is already
# streaming). Set to 0 to leave OBS on whatever scene it was on.
# RACECAST_OBS_STANDBY_ON_START=0

# Auto-failover to the Intermission scene (DEFAULT OFF, opt-in). When the ON-AIR feed
# stays down past the red grace window, automatically switch OBS to the Intermission
# scene so viewers see a clean holding card instead of a frozen/black frame. Fires once
# and pings Discord (@here); RETURN IS MANUAL -- the producer/director re-takes the feed
# when it recovers. Only fires while OBS is still on the on-air feed scene. Set to 1 to arm.
# RACECAST_AUTO_FAILOVER=1

# On-air auto-cover (#495): when an ON-AIR feed's source goes offline / not-live-yet /
# live-ended, the relay auto-raises the #378 "Standby Cover" over the picture (keeping the
# HUD) after a short settle, and lowers it again when the source is live. Default ON; set to
# a falsey value (0/false/no/off) to disable ONLY the automation -- the manual RED FLAG /
# Companion toggle still works. The gentler rung below RACECAST_AUTO_FAILOVER (keeps the HUD;
# fires ~12s in vs. the red grace; never cuts the scene).
# RACECAST_OBS_AUTO_COVER=1

# #493 robust ingest: auto FULL->ROBUST (720p) step-down when a source can't sustain 1080p.
# Default ON. =0 disables ONLY the automatic step-down (manual profile switching stays).
RACECAST_FEED_ROBUST_AUTO=1

# On-air program-audio monitor (Director Panel / Cockpit / Race Control): the
# relay encodes the on-air feed's audio to an MP3 stream the console pages can
# toggle on. Default ON, audio is muted until a listener clicks; the encoder is
# on-demand (zero cost when nobody listens) and requires the feed fan-out. Set to
# 0 to disable the feature entirely.
RACECAST_PROGRAM_AUDIO=1

# Two-stage feed arming (#492). Default ON: a stint URL in the schedule does NOT pull
# until the feed is armed in the Director Panel, and /next auto-stops the outgoing feed
# after a handover. Set to 0 to restore the legacy auto-pull + seamless whole-stint
# pre-roll (only advisable on a residential IP, where concurrent-pull throttling is a non-issue).
RACECAST_MANUAL_FEED_ARM=1

# OPTIONAL (Windows): full path to Companion.exe for `racecast companion start/stop`.
# Only needed when Companion sits in a NON-standard location -- the standard
# install paths are found automatically, e.g. the winget / install-apps default:
#   RACECAST_COMPANION_EXE=C:\Program Files\Companion\Companion.exe
RACECAST_COMPANION_EXE=

# OPTIONAL: port of the local Control Center web app (`racecast ui`). Set this only
# when another application on this machine already occupies the default 8089.
RACECAST_UI_PORT=

# RESERVED for the future remote-support feature (Control Center over
# Tailscale): not read by any current version -- leave commented out.
# RACECAST_UI_PASSWORD=

# Default active profile (league) when neither --profile nor an explicit
# RACECAST_PROFILE env var is given. Each league lives in profiles/<name>/.
# Leave unset if you keep exactly one profile (it is then selected implicitly).
RACECAST_PROFILE=

# Days before a stored bandwidth speed-test result is treated as stale by
# `racecast preflight` (WARN: "re-measure before the event"). Default 7.
RACECAST_SPEEDTEST_MAX_AGE_DAYS=7

# Commentator Cockpit (issue #191) is ZERO-CONFIG: the relay serves the
# commentator-facing /cockpit page automatically — a per-league CONSOLE_SECRET is
# generated on first relay start (in the active profile.env). Every request is
# token-gated, and the cockpit is exposed PUBLICLY only via the Funnel switch
# below. There is no separate enable flag to set.

# OPTIONAL: bring the public Funnel up automatically on `racecast event start`.
# event start exposes ONLY /console (the role-adaptive crew launcher) on
# https://<your-magicdns-host>/console — the preferred way to produce. ON by
# default (opt-out): set this to `false` to keep the relay tailnet/loopback-only.
# Toggle in the Control Center Crew Console view or set here. (Legacy name
# RACECAST_COCKPIT_FUNNEL still honored.)
RACECAST_FUNNEL=true

# OPTIONAL: Tailscale API credential for `racecast cockpit setup-funnel`, which
# automates the ONE-TIME tailnet prerequisites (enable MagicDNS + add the 'funnel'
# nodeAttr — both persist in the policy afterwards). You only need a credential for
# that single run: generate it, run setup-funnel, then revoke it + clear this line.
# It can rewrite the tailnet policy — treat like a password, never commit.
# Easiest: Admin console -> Settings -> Keys -> "API access tokens" -> Generate
# access token (a tskey-api-... value). API tokens expire (<=90 days) — irrelevant
# for this throwaway one-off; do NOT leave it here long-term.
RACECAST_TS_API_KEY=

# Discord interview audio on Linux without a native client (e.g. ARM64, where the
# official .deb is amd64-only): capture Discord-web from a browser instead.
# RACECAST_DISCORD_WEB: leave empty for auto (web when no native Discord is found),
# 1 to force the browser variant, 0 to force the native source.
# RACECAST_DISCORD_WEB_BROWSER: the browser process to capture (PipeWire match
# name) — defaults to a detected running browser, else Firefox.
#RACECAST_DISCORD_WEB=
#RACECAST_DISCORD_WEB_BROWSER=Firefox

# Solo mode (#303): local device ids for the OBS Solo Capture / Solo Webcam sources.
# Set by hand, or use `racecast device-scan` / the Control Center's Solo-devices
# picker to discover + save them automatically.
# macOS: AVFoundation device UID; Windows: "Name:\\?\\usb#..."; Linux: /dev/videoN.
RACECAST_CAPTURE=
RACECAST_WEBCAM=

# Endurance local stint (#592): a Schedule row whose URL cell is `local:` is read
# from RACECAST_CAPTURE by the relay's own ffmpeg (needs the feed fan-out, the
# default). The OBS id above works on Windows and Linux; on macOS ffmpeg needs the
# device NAME, not the UID. Game audio: leave RACECAST_CAPTURE_AUDIO empty and the
# relay uses the card's own audio device, found by name in ffmpeg's device list
# (e.g. video "Elgato HD60 X" -> audio "Elgato HD60 X (Elgato HD60 X)"). If none is
# found it runs picture-only and says so in the feed log and the Director Panel.
# Set a device here only to override that pick; `none` = deliberately no game audio.
RACECAST_CAPTURE_AUDIO=

# Tyres/fuel crop of GT7's tyre/fuel widget (solo Commentary only). Leave it empty,
# or set it to the same value as RACECAST_CAPTURE, when one capture card carries the
# game: the crop then reuses the capture card's source, which OBS can open only once.
# Set a different device only for a second card dedicated to the widget.
RACECAST_TYRES_CAPTURE=

# Solo mode (#307): local device id for the OBS "Commentary Mic Device" source —
# the commentator's own microphone, captured on the producer machine. Same
# discovery paths as above (`racecast device-scan --mic` / Control Center).
# macOS/Windows/Linux all key on the native input's device id.
# Endurance (#593): the same source is the producer's own mic for a local stint.
# It ships muted; the relay opens it only while the local stint is on air (Stint or
# Splitscreen) and closes it on every other handover. Only read with RACECAST_CAPTURE.
RACECAST_MIC=

# --- GT7 telemetry (solo / POV only; ignored in endurance) ---
# PS4/PS5 IP that runs GT7. Empty -> subnet-broadcast discovery at runtime. Set by
# hand, or use `racecast gt7-discover` / the Control Center's "Discover PlayStation"
# button (General Settings -> Solo devices) to find + save it automatically.
RACECAST_GT7_PS_IP=
# Master switch for the telemetry listener (1/0). Default on in solo.
RACECAST_GT7_TELEMETRY=1
# Display units: metric (km/h, °C, L) or imperial (mph, °F, gal).
RACECAST_TELEMETRY_UNITS=metric
# Tyre-temp colour band edges in °C (comparison always in °C; display converts).
RACECAST_TELEMETRY_TYRE_COLD=70
RACECAST_TELEMETRY_TYRE_OPTIMAL_HI=85
RACECAST_TELEMETRY_TYRE_HOT_HI=95
